# Copy to .env.local and fill in values before running `make dev-secrets`
# These are applied as k8s secrets in product-a and product-b namespaces.

# Auth0 M2M client secret for the backend (client ID is set in the Stack spec)
MX_AUTH0_CLIENT_SECRET=

# Postgres password (must match stack componentValues.postgres.auth.password)
MX_POSTGRES_PASSWORD=product
