FROM docker.io/library/node:22-bookworm-slim

ARG CLAUDE_CODE_VERSION=latest
ARG CODEX_VERSION=latest

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git gh jq openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global \
    "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force

RUN useradd --uid 10001 --create-home --shell /bin/bash agent \
    && install -d -o 10001 -g 10001 /workspace

COPY --chmod=0755 scripts/kubo-agent-deliver /usr/local/bin/kubo-agent-deliver

USER 10001:10001
ENV HOME=/home/agent \
    XDG_CONFIG_HOME=/home/agent/.config
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/kubo-agent-deliver"]
